<?xml version="1.0" encoding="UTF-8"?>
<GenAiPromptTemplate xmlns="http://soap.sforce.com/2006/04/metadata">
    <activeVersionIdentifier>{{promptVersionIdentifier}}</activeVersionIdentifier>
    <developerName>Contact_Enrichment_Analysis</developerName>
    <masterLabel>Contact Enrichment Analysis</masterLabel>
    <overridable>false</overridable>
    <templateVersions>
        <content>{{{promptContent}}}</content>
        <inputs>
            <apiName>Contact</apiName>
            <definition>SOBJECT://Contact</definition>
            <masterLabel>Contact</masterLabel>
            <referenceName>Input:Contact</referenceName>
            <required>true</required>
        </inputs>
        <isCitationEnabled>false</isCitationEnabled>
        <outputSchema>ContactEnrichmentOutput</outputSchema>
        <primaryModel>sfdc_ai__DefaultGPT5Mini</primaryModel>
        <responseFormat>JSON</responseFormat>
        <status>Published</status>
        <templateDataProviders>
            <definition>invocable://getDataForGrounding</definition>
            <description>Retrieves record data for grounding a prompt template.</description>
            <label>Record Snapshot</label>
            <parameters>
                <definition>primitive://String</definition>
                <isRequired>true</isRequired>
                <parameterName>recordId</parameterName>
                <valueExpression>{!$Input:Contact.Id}</valueExpression>
            </parameters>
            <referenceName>RecordSnapshot:Contact</referenceName>
        </templateDataProviders>
        <templateDataProviders>
            <definition>invocable://webSearchStream</definition>
            <description>Returns a webSearchSummary (a concise text summary of the top search findings) and citationSources (a list of sources used as references).</description>
            <label>Search The Web</label>
            <parameters>
                <definition>primitive://String</definition>
                <isRequired>true</isRequired>
                <parameterName>searchQuery</parameterName>
                <valueExpression>{{webSearchQuery}}</valueExpression>
            </parameters>
            <parameters>
                <definition>primitive://String</definition>
                <isRequired>false</isRequired>
                <parameterName>searchProvider</parameterName>
                <valueExpression>{{webSearchProvider}}</valueExpression>
            </parameters>
            <referenceName>SalesforceDataAction:webSearchStream</referenceName>
        </templateDataProviders>
        <versionIdentifier>{{promptVersionIdentifier}}</versionIdentifier>
    </templateVersions>
    <type>einstein_gpt__flex</type>
    <visibility>Global</visibility>
</GenAiPromptTemplate>
