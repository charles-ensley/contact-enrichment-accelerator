<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>[STAGED / INACTIVE] Auto-creates a Pending &quot;Status change&quot; enrichment suggestion when the LinkedIn Sales Navigator signal flags a contact as no longer at the company ({{linkedIn.departureFieldApiName}} = &quot;{{linkedIn.departureValue}}&quot;). Ships DEACTIVATED so the solution stays manual. Activate only after the customer has confirmed volume/limits are acceptable. Fires only when the field changes to meet the criteria, to avoid duplicate suggestions.</description>
    <environments>Default</environments>
    <interviewLabel>Contact Enrichment - Auto Capture LinkedIn Departure {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Enrichment - Auto Capture LinkedIn Departure</label>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Swallow_Fault</name>
        <label>Swallow Fault (non-blocking)</label>
        <locationX>440</locationX>
        <locationY>287</locationY>
        <description>Captures any suggestion-create fault into a variable and ends the flow normally, so a suggestion-create failure never rolls back the triggering Contact save.</description>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <recordCreates>
        <name>Create_Departure_Suggestion</name>
        <label>Create Departure Suggestion</label>
        <description>Creates a Pending Status_Change enrichment suggestion (Source = LinkedIn) proposing the &quot;departed&quot; status value.</description>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <faultConnector>
            <targetReference>Swallow_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Category__c</field>
            <value>
                <stringValue>Status_Change</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Confidence__c</field>
            <value>
                <numberValue>85.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Current_Value__c</field>
            <value>
                <elementReference>$Record.{{linkedIn.statusFieldApiName}}</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Field_API_Name__c</field>
            <value>
                <stringValue>{{linkedIn.statusFieldApiName}}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Field_Label__c</field>
            <value>
                <stringValue>{{linkedIn.statusFieldLabel}}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rationale__c</field>
            <value>
                <stringValue>LinkedIn Sales Navigator flagged this contact as no longer at the company ({{linkedIn.departureFieldApiName}} = &quot;{{linkedIn.departureValue}}&quot;). Review and confirm before updating the status.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source__c</field>
            <value>
                <stringValue>LinkedIn</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Suggested_Value__c</field>
            <value>
                <stringValue>{{linkedIn.statusDepartedValue}}</stringValue>
            </value>
        </inputAssignments>
        <object>Contact_Enrichment_Suggestion__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Departure_Suggestion</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>{{linkedIn.departureFieldApiName}}</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>{{linkedIn.departureValue}}</stringValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
